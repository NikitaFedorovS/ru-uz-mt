# Config file used by load_config() when --config is not passed (API, scripts)
RU_UZ_MT_CONFIG=configs/train_config.yaml

# Override any config field: RU_UZ_MT__<SECTION>__<FIELD>=<yaml value>
# RU_UZ_MT__MODEL__ADAPTER_PATH=models/ru-uz-lora
# RU_UZ_MT__MODEL__DEVICE=auto          # auto | cuda | mps | cpu
# RU_UZ_MT__GENERATE__NUM_BEAMS=4
# RU_UZ_MT__TRAIN__NUM_EPOCHS=1
# RU_UZ_MT__LORA__USE_QLORA=true

# API limits
MAX_INPUT_CHARS=2000
MAX_BATCH_SIZE=32
REQUEST_TIMEOUT_S=60
PORT=8000

# Logging / caches
LOG_LEVEL=INFO
# HF_HOME=~/.cache/huggingface
# HF_TOKEN=                              # only for gated datasets/models
# WANDB_API_KEY=                         # if train.report_to: wandb
# MLFLOW_TRACKING_URI=                   # if train.report_to: mlflow
